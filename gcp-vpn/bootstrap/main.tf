locals {
  bucket_name = coalesce(var.state_bucket_name, "${var.project_id}-pritunl-tfstate")
  state_path  = "pritunl/${var.environment}"
}

resource "google_project_service" "storage" {
  project            = var.project_id
  service            = "storage.googleapis.com"
  disable_on_destroy = false
}

resource "google_storage_bucket" "state" {
  project                     = var.project_id
  name                        = local.bucket_name
  location                    = coalesce(var.state_bucket_location, var.region)
  storage_class               = "STANDARD"
  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = false
  labels                      = merge(var.labels, { purpose = "terraform-state" })

  # Every state write is kept as a version, so a bad apply can be rolled back.
  versioning {
    enabled = true
  }

  lifecycle_rule {
    condition {
      num_newer_versions = var.state_versions_to_keep
      with_state         = "ARCHIVED"
    }
    action {
      type = "Delete"
    }
  }

  lifecycle {
    prevent_destroy = true
  }

  depends_on = [google_project_service.storage]
}

# Writes the main stack's backend config, so the bucket name lives in one place.
resource "local_file" "backend_config" {
  filename        = "${path.root}/../environments/${var.environment}/backend.hcl"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by bootstrap/ (make bootstrap ENV=${var.environment}). Do not edit by hand.
    bucket = "${google_storage_bucket.state.name}"
    prefix = "${local.state_path}"
  EOT
}
