#!/usr/bin/env bash
# Pritunl startup script (rendered by Terraform). Runs on every boot and is idempotent.
# Supports RHEL-family images (Rocky/Alma/Oracle Linux 9, Pritunl's tested platform)
# and Ubuntu. The boot disk is disposable: the MIG recreates it on autoheal. Everything
# that must survive lives on the stateful data disk and is bind-mounted onto the
# standard paths, so packages and SELinux policies see their usual locations:
#   <data disk>/mongodb      -> MongoDB dbPath (/var/lib/mongo or /var/lib/mongodb)
#   <data disk>/pritunl/lib  -> /var/lib/pritunl (Pritunl host ID)
set -euo pipefail
exec > >(tee -a /var/log/pritunl-startup.log) 2>&1
echo "=== pritunl startup $(date -Is) ==="

DATA_DEVICE="/dev/disk/by-id/google-${data_device_name}"
DATA_MOUNT="${data_mount_path}"
MONGODB_VERSION="${mongodb_version}"
INSTALL_OPS_AGENT="${install_ops_agent}"
SHIP_PRITUNL_LOGS="${ship_pritunl_logs}"
LETSENCRYPT_DOMAIN="${letsencrypt_domain}"

. /etc/os-release
case " $ID $ID_LIKE " in
  *" rhel "*|*" fedora "*|*" centos "*) OS_FAMILY=rhel ;;
  *" debian "*|*" ubuntu "*)            OS_FAMILY=debian ;;
  *) echo "unsupported OS: $ID"; exit 1 ;;
esac
echo "OS: $PRETTY_NAME ($OS_FAMILY), kernel $(uname -r)"

# Bind-mount SRC onto DST, persisted in fstab and ordered after the data disk mount.
bind_mount() {
  local src="$1" dst="$2"
  mkdir -p "$src" "$dst"
  grep -qE "^[^#]*[[:space:]]$dst[[:space:]]" /etc/fstab || \
    echo "$src $dst none bind,nofail,x-systemd.requires-mounts-for=$DATA_MOUNT 0 0" >> /etc/fstab
  mountpoint -q "$dst" || mount "$dst"
}

# --- 1. Mount the stateful data disk -------------------------------------------------
echo "### $(date -u +%T) step 1: data disk"
for _ in $(seq 1 60); do
  [ -b "$DATA_DEVICE" ] && break
  echo "waiting for $DATA_DEVICE"; sleep 5
done
[ -b "$DATA_DEVICE" ] || { echo "ERROR: data disk $DATA_DEVICE not found"; exit 1; }

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  echo "formatting new data disk"
  mkfs.ext4 -m 0 -E lazy_itable_init=0,lazy_journal_init=0,discard "$DATA_DEVICE"
fi

mkdir -p "$DATA_MOUNT"
DATA_UUID="$(blkid -s UUID -o value "$DATA_DEVICE")"
grep -q "$DATA_UUID" /etc/fstab || \
  echo "UUID=$DATA_UUID $DATA_MOUNT ext4 discard,defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$DATA_MOUNT" || mount "$DATA_MOUNT"
resize2fs "$DATA_DEVICE" || true   # picks up a disk resize done in Terraform

# Before installing Pritunl, so the package writes its host ID onto the data disk.
bind_mount "$DATA_MOUNT/pritunl/lib" /var/lib/pritunl

# --- 2. Install packages (only on a fresh boot disk) ---------------------------------
echo "### $(date -u +%T) step 2: packages"
if ! command -v pritunl >/dev/null 2>&1; then
  echo "installing MongoDB $MONGODB_VERSION, OpenVPN, WireGuard and Pritunl"

  if [ "$OS_FAMILY" = rhel ]; then
    RHEL_MAJOR="$(echo "$VERSION_ID" | cut -d. -f1)"
    cat > /etc/yum.repos.d/mongodb-org.repo <<EOF
[mongodb-org-$MONGODB_VERSION]
name=MongoDB Repository
baseurl=https://repo.mongodb.org/yum/redhat/$RHEL_MAJOR/mongodb-org/$MONGODB_VERSION/x86_64/
gpgcheck=1
enabled=1
gpgkey=https://pgp.mongodb.com/server-$MONGODB_VERSION.asc
EOF
    cat > /etc/yum.repos.d/pritunl.repo <<EOF
[pritunl]
name=Pritunl Repository
baseurl=https://repo.pritunl.com/stable/yum/oraclelinux/$RHEL_MAJOR/
gpgcheck=1
enabled=1
gpgkey=https://raw.githubusercontent.com/pritunl/pgp/master/pritunl_repo_pub.asc
EOF
    # No full "dnf update" here: it can outlast the autohealing grace period on small VMs.
    # Security updates are applied daily by dnf-automatic instead (configured below).
    dnf -y remove iptables-services || true
    dnf -y install --allowerasing pritunl pritunl-openvpn wireguard-tools mongodb-org \
      policycoreutils-python-utils dnf-automatic
  else
    CODENAME="$VERSION_CODENAME"

    # Stop services from auto-starting during install; they are configured first.
    printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d
    chmod +x /usr/sbin/policy-rc.d

    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y gnupg curl ca-certificates

    curl -fsSL "https://www.mongodb.org/static/pgp/server-$MONGODB_VERSION.asc" \
      | gpg -o "/usr/share/keyrings/mongodb-server-$MONGODB_VERSION.gpg" --dearmor --yes
    curl -fsSL https://swupdate.openvpn.net/repos/repo-public.gpg \
      | gpg -o /usr/share/keyrings/openvpn-repo.gpg --dearmor --yes
    curl -fsSL https://raw.githubusercontent.com/pritunl/pgp/master/pritunl_repo_pub.asc \
      | gpg -o /usr/share/keyrings/pritunl.gpg --dearmor --yes

    echo "deb [ signed-by=/usr/share/keyrings/mongodb-server-$MONGODB_VERSION.gpg ] https://repo.mongodb.org/apt/ubuntu $CODENAME/mongodb-org/$MONGODB_VERSION multiverse" \
      > /etc/apt/sources.list.d/mongodb-org.list
    echo "deb [ signed-by=/usr/share/keyrings/openvpn-repo.gpg ] https://build.openvpn.net/debian/openvpn/stable $CODENAME main" \
      > /etc/apt/sources.list.d/openvpn.list
    echo "deb [ signed-by=/usr/share/keyrings/pritunl.gpg ] https://repo.pritunl.com/stable/apt $CODENAME main" \
      > /etc/apt/sources.list.d/pritunl.list

    apt-get update -y
    apt-get install -y pritunl openvpn mongodb-org wireguard wireguard-tools

    rm -f /usr/sbin/policy-rc.d
  fi
fi

# Firewalling is done by GCP firewall rules; host firewalls interfere with Pritunl's iptables rules.
if [ "$OS_FAMILY" = rhel ]; then
  systemctl disable --now firewalld 2>/dev/null || true

  # Daily automatic security updates (replaces a slow full update at boot).
  if [ -f /etc/dnf/automatic.conf ]; then
    sed -i -E 's/^upgrade_type[[:space:]]*=.*/upgrade_type = security/; s/^apply_updates[[:space:]]*=.*/apply_updates = yes/' /etc/dnf/automatic.conf
    systemctl enable --now dnf-automatic.timer
  fi
else
  ufw disable || true
fi

# --- 3. MongoDB data on the data disk (localhost only) -------------------------------
echo "### $(date -u +%T) step 3: MongoDB data and SELinux"
MONGO_DBPATH="$(awk '/^[[:space:]]*dbPath:/ {print $2}' /etc/mongod.conf)"
MONGO_USER="$(systemctl show -p User --value mongod)"
[ -n "$MONGO_DBPATH" ] && [ -n "$MONGO_USER" ] || { echo "ERROR: cannot read mongod dbPath/user"; exit 1; }
sed -i -E "s|^([[:space:]]*bindIp:).*|\1 127.0.0.1|" /etc/mongod.conf

bind_mount "$DATA_MOUNT/mongodb" "$MONGO_DBPATH"
chown -R "$MONGO_USER:$MONGO_USER" "$MONGO_DBPATH"

# SELinux: label the data-disk directories exactly like the standard paths they replace,
# so a full relabel keeps them correct too.
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != "Disabled" ]; then
  # List first, then grep: piping into "grep -q" can SIGPIPE semanage and, with
  # pipefail, look like "not found", making the add fail on an existing rule.
  LOCAL_FCONTEXTS="$(semanage fcontext -l -C)"
  add_equivalence() {
    grep -qF "$1 = " <<<"$LOCAL_FCONTEXTS" || semanage fcontext -a -e "$2" "$1"
  }
  add_equivalence "$DATA_MOUNT/mongodb" "$MONGO_DBPATH"
  add_equivalence "$DATA_MOUNT/pritunl/lib" /var/lib/pritunl
  restorecon -RF "$MONGO_DBPATH" /var/lib/pritunl
fi

for svc in mongod pritunl; do
  mkdir -p "/etc/systemd/system/$svc.service.d"
  cat > "/etc/systemd/system/$svc.service.d/10-data-disk.conf" <<EOF
[Unit]
RequiresMountsFor=$DATA_MOUNT $MONGO_DBPATH /var/lib/pritunl
EOF
done
cat > /etc/systemd/system/pritunl.service.d/20-after-mongod.conf <<'EOF'
[Unit]
After=mongod.service
Wants=mongod.service
EOF
systemctl daemon-reload

# --- 4. Start MongoDB, then Pritunl --------------------------------------------------
echo "### $(date -u +%T) step 4: start MongoDB and Pritunl"
systemctl enable mongod
systemctl restart mongod
MONGO_OK=false
for _ in $(seq 1 30); do
  if mongosh --quiet --eval 'db.runCommand({ ping: 1 }).ok' >/dev/null 2>&1; then
    MONGO_OK=true; break
  fi
  sleep 2
done
if [ "$MONGO_OK" != true ]; then
  echo "ERROR: MongoDB did not start. Last mongod log lines:"
  journalctl -u mongod --no-pager | tail -20
  exit 1
fi

# The URI is always the local MongoDB, so it is (re)set on every boot instead of persisting pritunl.conf.
pritunl set-mongodb "mongodb://127.0.0.1:27017/pritunl"
systemctl enable pritunl
systemctl restart pritunl

# --- 5. Optional: Let's Encrypt certificate for the web server ------------------------
# A timer checks hourly until the domain's A record points at this VM's static IP, then
# sets the domain in Pritunl and requests the certificate once. Pritunl renews it itself.
# The certificate lives in MongoDB on the data disk, so a rebuilt VM keeps it.
cat > /etc/default/pritunl-acme <<EOF
ACME_DOMAIN="$LETSENCRYPT_DOMAIN"
MARKER_DIR="$DATA_MOUNT/pritunl"
EOF

cat > /usr/local/sbin/pritunl-acme.sh <<'EOF'
#!/usr/bin/env bash
set -uo pipefail
. /etc/default/pritunl-acme
[ -n "$ACME_DOMAIN" ] || exit 0
MARKER="$MARKER_DIR/acme-$ACME_DOMAIN.done"
[ -f "$MARKER" ] && exit 0

EXT_IP="$(curl -fsS -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/network-interfaces/0/access-configs/0/external-ip)"
DNS_IP="$(getent ahostsv4 "$ACME_DOMAIN" | awk 'NR==1 {print $1}')"
if [ "$DNS_IP" != "$EXT_IP" ]; then
  echo "pritunl-acme: $ACME_DOMAIN resolves to '$DNS_IP', expected $EXT_IP; retrying later"
  exit 0
fi

pritunl set app.acme_domain "$ACME_DOMAIN"
if pritunl renew-ssl-cert; then
  touch "$MARKER"
  systemctl restart pritunl   # load the new certificate (VPN clients reconnect)
  echo "pritunl-acme: certificate issued for $ACME_DOMAIN"
else
  echo "pritunl-acme: certificate request failed; retrying later"
fi
EOF
chmod 755 /usr/local/sbin/pritunl-acme.sh

cat > /etc/systemd/system/pritunl-acme.service <<'EOF'
[Unit]
Description=Request Let's Encrypt certificate for Pritunl
After=pritunl.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pritunl-acme.sh
EOF

cat > /etc/systemd/system/pritunl-acme.timer <<'EOF'
[Unit]
Description=Hourly Let's Encrypt check for Pritunl

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
EOF
systemctl daemon-reload

if [ -n "$LETSENCRYPT_DOMAIN" ]; then
  systemctl enable --now pritunl-acme.timer
else
  systemctl disable --now pritunl-acme.timer 2>/dev/null || true
fi

# --- 6. Optional: Google Cloud Ops Agent for logs and metrics -------------------------
if [ "$INSTALL_OPS_AGENT" = "true" ]; then
  if ! systemctl is-enabled --quiet google-cloud-ops-agent 2>/dev/null; then
    curl -sSfL https://dl.google.com/cloudagents/add-google-cloud-ops-agent-repo.sh -o /tmp/add-ops-agent.sh
    bash /tmp/add-ops-agent.sh --also-install || echo "ops agent install failed; continuing"
  fi

  # Send Pritunl's logs to Cloud Logging, so they survive VM recreates (the boot disk,
  # and /var/log with it, is replaced each time). Log names: pritunl_journal (JSON
  # events: connections, profile downloads, admin logins...) and pritunl_app.
  if [ "$SHIP_PRITUNL_LOGS" = "true" ] && [ -d /etc/google-cloud-ops-agent ]; then
    cat > /tmp/ops-agent-config.yaml <<'OPSAGENTCONFIG'
# Managed by the Pritunl startup script (Terraform). Merged with the agent's defaults.
logging:
  receivers:
    pritunl_journal:
      type: files
      include_paths:
        - /var/log/pritunl_journal.log
    pritunl_app:
      type: files
      include_paths:
        - /var/log/pritunl.log
        - /var/log/pritunl-startup.log
  processors:
    parse_pritunl_journal:
      type: parse_json
  service:
    pipelines:
      pritunl_journal:
        receivers: [pritunl_journal]
        processors: [parse_pritunl_journal]
      pritunl_app:
        receivers: [pritunl_app]
OPSAGENTCONFIG
    if ! cmp -s /tmp/ops-agent-config.yaml /etc/google-cloud-ops-agent/config.yaml; then
      install -m 0644 /tmp/ops-agent-config.yaml /etc/google-cloud-ops-agent/config.yaml
      systemctl restart google-cloud-ops-agent || echo "ops agent restart failed; continuing"
      echo "ops agent: shipping Pritunl logs to Cloud Logging"
    fi
  fi
fi

echo "=== pritunl startup finished $(date -Is) ==="
