.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
# Keep the tiny bootstrap state (state bucket only, no secrets) in git.
!environments/*/bootstrap.tfstate
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# --- VPN user data: never commit (all environments) ---------------------------
# Profiles (.tar = user private keys) and per-user details (.details.csv, may hold PINs)
scripts/users/*/profiles/
scripts/users/non-prod/profiles/
scripts/users/production/profiles/
profiles/
*.tar
*.details.csv
# Plaintext user lists: only enc_user_details.enc is committed
scripts/users/*/users.csv
*.enc.tmp
__pycache__/
